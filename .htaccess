# Сгенерировано tools/make-htaccess.js из _redirects. Руками не править:
# правьте _redirects и запускайте node tools/make-htaccess.js (T-090).
#
# cPanel/Apache: реальные 301 вместо страниц-заглушек, один редирект на https,
# www → apex с сохранением пути, кэш, заголовки безопасности, gzip.
# Требует AllowOverride FileInfo (обычно включён на shared-хостинге).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → apex: один 301 сразу на https, без промежуточного https://www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http → https для основного имени
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Старые адреса статей: 16 правил из _redirects.
  # Через mod_rewrite, а не Redirect 301: на hothat (LiteSpeed) блок mod_alias
  # отрабатывает не на всех воркерах, и часть старых адресов отдавала
  # страницу-заглушку с кодом 200 вместо 301 (T-157).
  RewriteRule ^article/rabochij-ugolok-v-odnushke-s-rebenkom/?$ /article/rabochee-mesto-v-odnushke-s-rebenkom/ [R=301,L]
  RewriteRule ^article/stol-s-elektroprivodom-vs-obychnyj/?$ /article/stol-s-elektroprivodom-polza-dlya-spiny/ [R=301,L]
  RewriteRule ^article/5-luchshih-ergonomichnyh-kresel-do-35000/?$ /article/5-luchshih-ergonomichnyh-kresel-rejting/ [R=301,L]
  RewriteRule ^article/skrinbar-na-monitor-pochemu-nastolnaya-lampa-portit-zrenie/?$ /article/skrinbar-na-monitor-vybor-zashchita-glaz/ [R=301,L]
  RewriteRule ^article/kristalnyj-zvuk-na-sozvonah-bez-krikov-detej/?$ /article/mikrofon-s-shumopodavleniem-dlya-zvonkov/ [R=301,L]
  RewriteRule ^article/kabel-menedzhment-pod-stolom-za-1-chas-i-2500-rublej/?$ /article/kabel-menedzhment-pod-stolom-svoimi-rukami/ [R=301,L]
  RewriteRule ^article/kronshtejn-dlya-monitora-i-podstavka-dlya-nog/?$ /article/kronshtejn-dlya-monitora-ergonomika-shei/ [R=301,L]
  RewriteRule ^article/metod-svetofor-tajm-menedzhment-dlya-roditelej/?$ /article/metod-svetofor-udalenka-s-detmi/ [R=301,L]
  RewriteRule ^article/rabochee-mesto-dlya-dvoih-v-odnoj-komnate/?$ /article/rabochee-mesto-dlya-dvoih-v-komnate/ [R=301,L]
  RewriteRule ^article/podstavki-dlya-nog-ergonomika-oteki/?$ /article/podstavka-dlya-nog-pod-stol-ergonomika/ [R=301,L]
  RewriteRule ^article/vybor-kronshtejna-dlya-monitora-gazlift/?$ /article/kronshtejn-dlya-monitora-na-stol-vybor/ [R=301,L]
  RewriteRule ^article/akusticheskie-paneli-peregorodki-dlya-kvartiry/?$ /article/akusticheskie-paneli-dlya-domashnego-kabineta/ [R=301,L]
  RewriteRule ^article/v-kakoj-komnate-luchshe-rabotat-doma/?$ /article/v-kakoj-komnate-luchshe-rabotat-na-udalenke/ [R=301,L]
  RewriteRule ^article/kuda-postavit-rabochij-stol-okno-batareya-rozetki/?$ /article/kuda-postavit-rabochij-stol-v-komnate/ [R=301,L]
  RewriteRule ^article/domashnij-ofis-s-nulya-chto-kupit-srazu-a-chto-zaminit/?$ /article/domashnij-ofis-s-nulya-nedorogo/ [R=301,L]
  RewriteRule ^article/kak-podgotovitsya-k-udalennoj-rabote-v-poezdke/?$ /article/udalennaya-rabota-v-poezdke-i-otpuske/ [R=301,L]
</IfModule>

# Сжатие: на cPanel без него страницы уезжают в сеть как есть.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

# Кэш. Имена файлов не хешируются, поэтому у assets короткий срок, а не год:
# иначе после выкладки браузер держит старый бандл.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hours"
  ExpiresByType text/plain "access plus 1 hours"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
</IfModule>

# Заголовки, которые на GitHub Pages задавались только meta-тегами.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# HSTS — только через сутки нормальной работы, раскомментировать строку ниже
# (docs/migration-hothat.md, шаг 4). Раньше нельзя: ошибка с сертификатом
# запомнится браузером на год.
# Header always set Strict-Transport-Security "max-age=31536000"
